# Handy temporaries at low addresses

tmpa	data	0
tmpb	data	0

# Variables for division, also must be at low addresses

remainder data 0
quotient data 0

# Handy short ops, callable with two nybbles

# duplicate pushes a duplicate of the TOS
# uses tmpa

duplicate push tmpa
	store push tmpa
	fetch return

# double multiplies the TOS by 2
# uses duplicate and thus tmpa

double	call duplicate
	add return

# Absolute value

abs	call duplicate
	push 
	0x800
	and snz drop
	return
	neg return
	
# Host calls use jump -1, host detects this, compares pc to symbols
# to figure out which call. Args on stack. Guest is responsible for stack
# manipulation, host only reads or modifies values, not stack pointer.	
# put byte
	nop	# Avoid race where PC is putc
putc	jump	-1
	drop return

# put word as hexadecimal

putx	jump	-1
	drop return

putxsp	call putx
	push 0x20
	call putc
	return

# return TOS as exit code

exit	jump	-1

# output newline

putnl	push 10
	call putc
	return

# 11 bit positive divide
# args: dividend divisor
# args must not be negative
# divisor must not be zero (infinite loop!)

pdiv	swap push remainder # in the beginning, the dividend is the remainder
	store drop
	push 1		# initial count of potential quotient bits
divnorm	swap call duplicate	# current unnormalized divisor
	push
	0x400		# test msb
	and 
	snz snz snz	# skip over three words if divisor normalized
 	drop call double # drop test bit, double divisor
	swap not neg	# increment bit count
	jump @divnorm

# at this point, the TOS is useless 0x400. The normalized divisor, and the
# count of potential quotient bits is below that. 

	drop push 0
	push quotient
	store drop	# initialize quotient
	
# Loop comparing the divisor
# to the remainder, halving the divisor each time

divstep	call duplicate 	# copy divisor for subtraction
	neg push remainder # prepare to subtract
	fetch swap add	# subtract divisor from remainder
	call duplicate	# for test
	push 
	0x800		# sign bit
	and snz drop	# if negative, quotient bit is zero
	jump @div1	# we have a one bit

# The adjusted remainder in the TOS is wrong, so just drop
# it and leave the remainder in memory alone.

	drop push 0		# result bit
	jump @divshift

div1	push remainder	# save adjusted remainder
	store drop
	push 1		# result bit
	
divshift push quotient
	fetch call double	# double the quotient
	add push quotient	# add in the bit
	store drop swap		# save it, count to TOS
	neg not snz		# decrement count
	jump @divdone
	swap half		# adjust divisor for next step		
	jump @divstep
	
divdone drop drop return	# results are in quotient, remainder 

# Fibonacci numbers

fn1	data	1
fn	data	1

fib	push	fn1
	fetch
	push fn
	fetch
	push fn1
	store add
	push fn
	store return	

absfib	call fib
	call abs
	return

start	push 0

loop	call absfib	# dividend
	call duplicate
	call putxsp
	call absfib	# divisor
	call absfib	# and kills some bits, making it smaller
	and snz
	push 1		# don't divide by zero
	call duplicate
	call putxsp
	call pdiv
	push quotient
	fetch
	call putxsp
	push remainder
	fetch
	call putx
	call putnl
	neg not snz
	jump @done
	jump @loop
	
done	push 0
	call exit
	
