# Host calls use jump -1, host detects this, compares pc to symbols
# to figure out which call. Args on stack. Guest is responsible for stack
# manipulation, host only reads or modifies values, not stack pointer.	
# put byte
putc	jump	-1
	drop return

# put word as hexadecimal

putx	jump	-1
	drop return

# return TOS as exit code

exit	jump	-1

# output newline

putnl	literal 10
	call putc
	return

start	literal 0x48	H
	call putc
	literal 0x65	e
	call putc
	literal 0x6C	l
	call putc
	literal 0x6C	l
	call putc
	literal 0x6F	o
	call putc

world	data 0x20
	data 0x57	W
	data 111	o
	data 114	r
	data 108	l
	data 100	d

waddr	data world

	literal 6	count
woloop	snz		# test for zero
	jump @woend
	literal waddr
	fetch fetch
	call putc
	literal waddr
	fetch not neg	addr++
	literal waddr
	store drop
	neg not 	
	jump @woloop
woend	=	.

	literal 10
	call putc
	literal
	0xf00
	call putx
	call putnl

	literal 20
cloop	snz
	jump	@cend
	call	count
	call	putx
	literal 0x20
	call	putc
	neg not
	jump	@cloop
cend	=	.
	call putnl

	literal 20
floop	snz
	jump	@fend
	call	fib
	call	putx
	literal 0x20
	call	putc
	neg not
	jump	@floop
fend	=	.
	call putnl

# Fibonacci seeded tests

# First, compute a number, print it
	call fib
	call putxsp

# test the half instuction 
	literal fn
	fetch half
	call putxsp

# test the and instruction, using previous F number
	literal fn
	fetch
	literal fn1
	fetch and
	call putxsp

	call putnl

	literal 0
	call exit

counter	data	0

count	literal counter
	fetch
	not neg
	literal counter
	store return

# Fibonacci numbers

fn1	data	1
fn	data	1

fib	literal	fn1
	fetch
	literal fn
	fetch
	literal fn1
	store add
	literal fn
	store return	
	
putxsp	call putx
	literal 0x20
	call putc
	return
