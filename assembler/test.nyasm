# for now, start at loc 0

	literal 0x48	H
	call put
	literal 0x65	e
	call put
	literal 0x6C	l
	call put
	literal 0x6C	l
	call put
	literal 0x6F	o
	call put

world	data 0x20
	data 0x57	W
	data 111	o
	data 114	r
	data 108	l
	data 100	d

waddr	data world

	literal 6	count
woloop	snz
	jump @woend
	literal waddr
	fetch fetch
	call put
	literal waddr
	fetch not neg	addr++
	literal waddr
	store drop
	neg not 	
	jump @woloop	

woend	literal 0
	call exit

# Host calls use jump -1, host detects this, compares pc to symbols
# to figure out which call. Args on stack.

put	jump	-1
	drop return

exit	jump	-1
