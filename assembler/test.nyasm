# Handy temporaries at low addresses

tmpa	data	0
tmpb	data	0

# Host calls use jump -1, host detects this, compares pc to symbols
# to figure out which call. Args on stack. Guest is responsible for stack
# manipulation, host only reads or modifies values, not stack pointer.	
# put byte
putc	jump	-1
	drop return

# put word as hexadecimal

putx	jump	-1
	drop return

# return TOS as exit code

exit	jump	-1

# output newline

putnl	literal 10
	call putc
	return

# Output a counted string
# Takes pointer to string on TOS
# Uses tmpa

putstr	literal tmpa
	store fetch	# save address, get count
lputstr	snz		# test for zero
	jump @eputstr
	literal tmpa
	fetch not neg	# fetch and increment address
	literal tmpa
	store fetch	# save address, fetch char
	call putc
	neg not 	# decrement count
	jump @lputstr
eputstr drop return

hello	string	Hello World!

start	literal hello
	call putstr
	call putnl

ctmsg	string Let's count:
	literal ctmsg
	call putstr
	call putnl

	literal 20
cloop	snz
	jump	@cend
	call	count
	call	putx
	literal 0x20
	call	putc
	neg not
	jump	@cloop
cend	drop
	call putnl

fmsg	string Fibonacci numbers mod 2^12:
	literal fmsg
	call putstr
	call putnl

	literal 20
floop	snz
	jump	@fend
	call	fib
	call	putx
	literal 0x20
	call	putc
	neg not
	jump	@floop
fend	drop
	call putnl

	literal 0
	call classify

# Fibonacci seeded tests

	literal 10
fcloop	snz
	jump	@fcend
	call	fib
	call	classify
	neg not
	jump	@fcloop
fcend	drop

# First, compute a number, print it
	call fib
	call putxsp

# test the half instuction 
	literal fn
	fetch half
	call putxsp

# test the and instruction, using previous F number
	literal fn
	fetch
	literal fn1
	fetch and
	call putxsp

	call putnl

	literal 0
	call exit

counter	data	0

count	literal counter
	fetch
	not neg
	literal counter
	store return

# Fibonacci numbers

fn1	data	1
fn	data	1

fib	literal	fn1
	fetch
	literal fn
	fetch
	literal fn1
	store add
	literal fn
	store return	
	
putxsp	call putx
	literal 0x20
	call putc
	return

# Print TOS and classify as negative, zero or positive
# Implementation is a bit inefficient so that I could try
# a FORTRAN-II-style three way branch.

classify literal tmpa
	store
	call putxsp
	literal tmpa
	fetch

# Three way branch
	
	literal	
	0x800	# Mask for sign bit
	swap
	snz and snz
	jump	@zero
	jump	@positive
	jump	@negative

negs	string is negative
negative drop 
	literal negs
	call putstr
	call putnl
	return

zeros	string is zero
zero	drop
	literal zeros
	call putstr
	call putnl
	return

poss	string is positive
positive drop
	literal poss
	call putstr
	call putnl
	return
