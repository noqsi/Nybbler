# case construct
(case) : swap dup rot =
case : ' (case) >code ' |jmp >code heritage? if >code || drop ' {nothing} >code
' case immediate


cloc :variable	# current location in code space
dloc :variable	# current location in data space
iword :variable # current instruction word under construction
islot :variable	# subinstruction slots remaining in current word


# iempty yield nothing
# empty the instruction under contruction
iempty : 3 islot ! 0 iword !

iempty 0 cloc ! 0 dloc ! # initialize

!code : CODE + >UAR >MEM

# i >code++ yields nothing
# write i to code memory
>code++ : cloc @ !code cloc @ 1 + cloc !

# // yields nothing
# if the current instruction is empty, do nothing
# otherwise, write it out, 
// : islot @ 3 = || iword @ >code++ iempty

.label : // cloc @ :def >named_constant< cinit
' .label sooner

iword-append : iword @ 16 * + iword !

# i emit-short yields nothing
emit-short : iword-append islot @ 1 - dup islot ! 0= && //

finish-long : drop iword @ >code++ >code++ iempty
finish-long : 2 case drop \ 00f & iword @ 16 * | >code++ iempty
finish-long : 3 case drop \ 0ff & iword @ 256 * | >code++ iempty

emit-long : iword-append islot @ finish-long

# n check-signed yields n
# n check-unsigned yields n
# Print warning if host number can't be represented by 12 bits

12tosigned : \ fff & dup \ 800 & 0= || -4096 +

signed-wraps : dup -2048 < || dup 2047 >
warn-signed : signed-wraps && " Warning: " ,t dup , \
	"  wraps to " ,t dup 12tosigned ,
	
unsigned-wraps : dup 0 < || dup 4095 >
warn-unsigned : unsigned-wraps && " Warning: " ,t dup , \
	"  wraps to " ,t dup \ fff & ,

# n check-signed yields n12
# Checks to see if a long argument can fit in the
# available slots (one less than islot). If it won't, force
# it into the next word by setting islot to 1.
# Masks n to 12 bits.

(check-signed) : drop # default is to do nothing
(check-signed) : 3 case drop dup \ f80 < && dup \ 07f > && 1 islot !
(check-signed) : 2 case drop dup \ ff8 < && dup \ 007 > && 1 islot !
check-signed : warn-signed \ fff & islot @ (check-signed)

(check-unsigned) : drop # default is to do nothing
(check-unsigned) : 3 case drop dup \ 0ff > && 1 islot !
(check-unsigned) : 2 case drop dup \ 00f > && 1 islot !
check-unsigned : warn-unsigned \ fff & islot @ (check-unsigned)


# opcodes

.nop : 0 emit-short
.half : 1 emit-short
.neg : 2 emit-short
.not : 3 emit-short
.return : 4 emit-short
.snz : 5 emit-short
.add : 6 emit-short
.and : 7 emit-short
.fetch : 8 emit-short
.store : 9 emit-short
.swap : 10 emit-short
.drop : 11 emit-short
.extend : check-unsigned 12 emit-long
.call : check-unsigned 13 emit-long
.jump : check-signed 14 emit-long
.literal : check-signed 15 emit-long

# macro for absolute jump (labels are absolute)

.jlabel : cloc @ 1 + - .jump

# Scratch variable locations

-8 ;a :constant
-7 ;b :constant
-6 ;c :constant
-5 ;d :constant
-4 ;e :constant
-3 ;f :constant
-2 ;g :constant
-1 ;h :constant
0 ;s :constant
1 ;t :constant
2 ;u :constant
3 ;v :constant
4 ;w :constant
5 ;x :constant
6 ;y :constant
7 ;z :constant

# Useful macros

1+ : .not .neg
1- : .neg .not
.sub : .not .add
