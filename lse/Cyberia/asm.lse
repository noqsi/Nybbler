
;instruction :variable
0 ;instruction !

# The PC is the assembler's notion of where the next instruction
# will appear in program memory. It counts target processor words.
;pc :variable
0 ;pc !

# The offset is the host memory address corresponding
# to a PC of zero.
;pc_offset :variable

# .; yields nothing
# put instruction in output buffer

.; : ;instruction @ ;pc_offset @ ;pc @ [] ! ;pc @ 1 + ;pc ! 0 ;instruction !


# n >nyb yields nothing
# append nybble n to the current instruction word

>nyb : ;instruction @ 4 << + ;instruction !

# d n (arg-mask) yields d n
# where the output d is masked to n nybbles

(arg-mask) : dup rot swap 4* bits & swap

# d n (arg) yields nothing
# make a data field n nybbles wide, append/emit as needed

(arg) : ;instruction @ swap 4 * << + ;instruction ! .;
(arg) : (arg-mask) %nybbles case drop .; ;instruction ! .;

# opcodes

\ 0 %nop :constant
\ 1 %return :constant
\ 2 %tsz :constant
\ 3 %half :constant
\ 4 %add :constant
\ 5 %neg :constant
\ 6 %and :constant
\ 7 %not :constant
\ 8 %fetch :constant
\ 9 %store :constant
\ a %swap :constant
\ b %dup :constant
\ c %call :constant
\ d %jump :constant
\ e %literal :constant
\ f %extend :constant

# Assembly ops. These append the instruction to the current
# instruction word under construction.

.nop : %nop >nyb
.return : %return >nyb
.tsz : %tsz >nyb
.half : %half >nyb
.add : %add >nyb
.neg : %neg >nyb
.and : %and >nyb
.not : %not >nyb
.fetch : %fetch >nyb
.store : %store >nyb
.swap : %swap >nyb
.dup : %dup >nyb

# Long ops. These invoke .; as needed.

.call : %call >nyb (arg)
.jump : %jump >nyb (arg)
.literal : %literal >nyb (arg)
.extend : %extend >nyb (arg)

# Location tagging
# Tags are integers 0-99 identifying locations

100 ;tags :array
.tag : ;tags swap [] ;pc @ !
.absolute : ;tags swap [] @
.relative : .absolute ;pc @ -
