# opcodes

\ 0 %nop :constant
\ 1 %return :constant
\ 2 %tsz :constant
\ 3 %half :constant
\ 4 %add :constant
\ 5 %neg :constant
\ 6 %and :constant
\ 7 %not :constant
\ 8 %fetch :constant
\ 9 %store :constant
\ a %swap :constant
\ b %dup :constant
\ c %call :constant
\ d %jump :constant
\ e %literal :constant
\ f %extend :constant


# Intermediate code compiler
# initialize these before calling {ic_scan}

;icp :variable # intermediate code pointer
;icend :variable # intermediate code end
;icpass :variable # pass number
;icerror: variable # error id

# compiler pseudo-opcodes

\ 10 %nop | %%align :constant
\ 10 %jump | %%tolabel :constant

# label if this bit is set

\ 800 %%labelbit :constant

# scan dispatcher

scan1 : ,h "  is not recognizable intermediate code" nl 1 ;icerror !
scan1 : dup %%labelbit & then mklabel
scan1 : dup %%tolabel = then jmp_to_label>
scan1 : dup %%align = then align>
scan1 : dup %%align < then long>
scan1 : dup %call < then short>

{ic_scan} : ;icend @ ;icp @ u< && icp @@+ scan1 ;icerror 0 = &repeat
