# "registers"
# Host definitions
variables
;s ;t ;u ;v ;w ;x ;y ;z

# Shift and mask stuff
2* : dup +
4* : 4 *
8* : 8 *
16* : 16 *
<< : 2* iterate
bit+ : 2* 1 +
bits : 0 swap bit+ iterate

# case construct
(case) : swap dup rot =
case : ' (case) >code ' |jmp >code heritage? if >code || drop ' {nothing} >code
' case immediate

# a @++ yields x
# increments cell at a, yields unincremented contents

@++ : dup @ 1 + dup rot !
