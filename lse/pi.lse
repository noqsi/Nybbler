" ico" loadmod

# Command bits

1 DR>DRX :constant
2 DR->AR :constant
4 DR->ARX :constant
8 INCAR :constant
16 READ :constant
32 WRITE :constant
64 START :constant
128 HALT :constant

# >CMD yields nothing
>CMD : 1 ico-put

# Read/write "unified" registers

# 16 bit core status
# <STATUS yields n
<STATUS : 1 ico-poll 256 * 0 ico-poll +

# 12 bit data
# <UDR yields n
<UDR : 1 ico-get 256 * 0 ico-get +

# n >UDR yields nothing
>UDR : dup 256 / 0 ico-put DR->DRX >CMD 0 ico-put

# 16 bit address
# n >UAR yields nothing
>UAR : dup 256 / 0 ico-put DR->ARX >CMD 0 ico-put DR-AR >CMD

# Read/write memory from UAR address

# <MEM yields n
<MEM : READ >CMD <UDR
# also increment UAR
<MEM++ : READ INCAR | >CMD <UDR

# n >MEM yields nothing
>MEM : >UDR WRITE >CMD
>MEM++ : >UDR WRITE INCAR | >CMD
