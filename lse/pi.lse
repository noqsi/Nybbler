" ico" loadmod

# Base addrs for segments

\ 1000 DATA :constant
\ 2000 CODE :constant
\ 3000 NUMBER :constant
\ 4000 RETURN :constant
\ 5000 REGS :constant

# Register addresses

REGS 0 + PC :constant
REGS 1 + RSP :constant
REGS 2 + TOS :constant
REGS 3 + SP :constant

# Command bits

1 DR->DRX :constant
2 DR->AR :constant
4 DR->ARX :constant
8 INCAR :constant
16 READ :constant
32 WRITE :constant
64 START :constant
128 HALT :constant

# >CMD yields nothing
>CMD : 1 ico-put

# Read/write "unified" registers

# 16 bit core status
# <STATUS yields n
<STATUS : 1 ico-poll 256 * 0 ico-poll +

# 12 bit data
# <UDR yields n
<UDR : 1 ico-get 256 * 0 ico-get +

# n >UDR yields nothing
# mask so / may be used for shift
>UDR : \ fff & dup 256 / 0 ico-put DR->DRX >CMD 0 ico-put

# Remember what's in UAR

UARshadow :variable

# 16 bit address
# n >UAR yields nothing
>UAR : \ ffff & dup UARshadow ! dup 256 / 0 ico-put DR->ARX >CMD 0 ico-put DR->AR >CMD

# Read/write memory from UAR address

# <MEM yields n
<MEM : READ >CMD <UDR
# also increment UAR
<MEM++ : READ INCAR | >CMD <UDR UARshadow @ 1 + UARshadow !

# n >MEM yields nothing
>MEM : >UDR WRITE >CMD
>MEM++ : >UDR WRITE INCAR | >CMD UARshadow @ 1 + UARshadow !

# <PC yields n
<PC : PC >UAR <MEM

# n >PC yields nothing
>PC : PC >UAR >MEM

# <RSP yields n
<RSP : RSP >UAR <MEM

# n >RSP yields nothing
>RSP : RSP >UAR >MEM

# <TOS yields n
<TOS : TOS >UAR <MEM

# n >TOS yields nothing
>TOS : TOS >UAR >MEM

# <SP yields n
<SP : SP >UAR <MEM

# n >SP yields nothing
>SP : SP >UAR >MEM



,3h : \ fff & dup \ 100 / ,h dup \ ff & \ 10 / ,h \ f & ,h

dump1 : <MEM++ ,3h sp 

dump16 : 16 dump1 iterate nl

dump4096 : 256 dump16 iterate

# n dumpline yields nothing
# dump a line of n words tagged with address

dumpline : UARshadow @ ,h sp dump1 iterate nl

# n dumplines yields nothing
# dump n words as lines of 16
(dumplines) : dup 16 < || 16 dumpline 16 - repeat
dumplines : (dumplines) dumpline

# n m dump@ yields nothing
# Dump n words starting at m

dump@ : >UAR dumplines

(fill4096) : 4096 count - >MEM++

fill4096 : 4096 (fill4096) iterate

PC> : " PC:  " ,t <PC ,3h
RSP> : " RSP: " ,t <RSP ,3h
TOS> : " TOS: " ,t <TOS ,3h
SP> : " SP:  " ,t <SP ,3h
NOS> : " NOS: " ,t NUMBER <SP + >UAR <MEM ,3h

tab : " 	" ,t

regs : PC> tab RSP> tab SP> tab TOS> tab NOS>


next : " Next: " ,t CODE <PC + >UAR <MEM ,3h

step : START HALT | >CMD

s : step regs nl next nl



