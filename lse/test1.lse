" pi.lse" load
" asm12.lse" load

.or	.label
	.not .swap .not 
	.and .not .return

.xor	.label
	;a .literal 
	.store .swap ;b .literal
	.store .or .call
	;a .literal
	.fetch ;b .literal
	.fetch .and .not
	.and .return
	
test	.label

	\ 50f .literal
	\ a0f .literal
	.or .call
	;s .literal
	.store
	\ 50f .literal
	.xor .call
	;t .literal
	.store .drop
end	.label
	end .jlabel


" Starting..." ,t nl
DATA >UAR dump16
test >PC START >CMD
1000 usec HALT >CMD
" Result:" ,t nl
DATA >UAR dump16
	
steps : test >PC 20 s iterate
