# Working variables for low level code

variables 
s t u v w x y z

# Words from the original LSE

# Indirect fetch, increment pointer

@@+ : dup @ @ swap dup @ 1 + swap !

@+! : dup @ 1 + swap !

# Indirect store, increment pointer

@!+ : dup t ! @ ! t @ @+!

# drop TOS

drop : tsz {} ;;

# subtract

- : neg +

# shift left

2* : dup +

# or

| : ~ swap ~ and ~ 

# xor (uses s and t temporaries)

^ : dup s ! swap dup t ! | s @ ~ t @ ~ | &

# Multilevel return.
# These take asdvantage of the semantics of the return instruction
# where instructions after the return within a word are executed.
# Need at least a 12 bit word for these to work.

# return two levels

<] : ] ]		# + implicit return from def

# drop TOS and return

]. : drop ]	# + implicit ret

# drop TOS and return two levels

<]. : drop ] ] 

