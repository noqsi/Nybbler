# Handy temporaries at low addresses

tmpa	data	0
tmpb	data	0

# duplicate pushes a duplicate of the TOS
# uses tmpa

duplicate push tmpa
	store push tmpa
	fetch return

# Host calls use jump -1, host detects this, compares pc to symbols
# to figure out which call. Args on stack. Guest is responsible for stack
# manipulation, host only reads or modifies values, not stack pointer.	
# put byte
putc	jump	-1
	drop return

# put word as hexadecimal

putx	jump	-1
	drop return

# return TOS as exit code

exit	jump	-1

# output newline

putnl	push 10
	call putc
	return

# Output a counted string
# Takes pointer to string on TOS
# Uses tmpa

putstr	push tmpa
	store fetch	# save address, get count
lputstr	snz		# test for zero
	jump @eputstr
	push tmpa
	fetch not neg	# fetch and increment address
	push tmpa
	store fetch	# save address, fetch char
	call putc
	neg not 	# decrement count
	jump @lputstr
eputstr drop return

# Absolute value (one's complement)
# Always returns positive at the cost of adjusting by 1
# toward 0 for negative input

abs1	call duplicate
	push 
	0x800
	and snz drop
	return
	not return

hello	string	Hello World!

$start	push hello
	call putstr
	call putnl

ctmsg	string Let's count:
	push ctmsg
	call putstr
	call putnl

	push 20
cloop	snz
	jump	@cend
	call	count
	call	putx
	push 0x20
	call	putc
	neg not
	jump	@cloop
cend	drop
	call putnl

fmsg	string Fibonacci numbers mod 2^12:
	push fmsg
	call putstr
	call putnl

	push 20
floop	snz
	jump	@fend
	call	fib
	call	putx
	push 0x20
	call	putc
	neg not
	jump	@floop
fend	drop
	call putnl
	
	call try2
	call try3

	push 0
	call classify

# Fibonacci seeded tests

	push 10
fcloop	snz
	jump	@fcend
	call	fib
	call	classify
	call	fib
	call	abs1
	call	evenodd
	call	fib
	call	tryhalf
	neg not
	jump	@fcloop
fcend	drop

	push 0
	call exit

counter	data	0

count	push counter
	fetch
	not neg
	push counter
	store return

# Fibonacci numbers

fn1	data	1
fn	data	1

fib	push	fn1
	fetch
	push fn
	fetch
	push fn1
	store add
	push fn
	store return	
	
putxsp	call putx
	push 0x20
	call putc
	return

# Print TOS and classify as negative, zero or positive
# Implementation is a bit inefficient so that I could try
# a FORTRAN-II-style three way branch.

classify push tmpa
	store
	call putxsp
	push tmpa
	fetch

# Three way branch
	
	push	
	0x800	# Mask for sign bit
	swap
	snz and snz
	jump	@zero
	jump	@positive
	jump	@negative

negs	string is negative
negative drop 
	push negs
	call putstr
	call putnl
	return

zeros	string is zero
zero	drop
	push zeros
	call putstr
	call putnl
	return

poss	string is positive
positive drop
	push poss
	call putstr
	call putnl
	return

try3	call	down1
	call	putstr
	call	putnl
	return

down1	call	down2
	push 1		# shouldn't get here
	call exit
	
down2	call	return3
	push 2		# shouldn't get here
	call exit

return3	push r3ok
	return return return

r3ok	string Triple return succeeded!

try2	call	mid
	call	putstr
	call	putnl
	return

mid	call	return2
	push 3		# shouldn't get here
	call exit

return2 push r2ok
	return return

r2ok	string Double return succeeded!


# Two way (potentially long) branch

evenodd	push tmpa
	store
	call putxsp
	push tmpa
	fetch push 1
	and snz jump
	@even
	@odd
fineo	call putstr
	call putnl
	return

seven	string is even
sodd	string is odd

even	drop
	push seven
	jump @fineo

odd	drop
	push sodd
	jump @fineo

# Exercise the half instruction

tryhalf	push tmpb
	store
	push halfof
	call putstr
	call putxsp
	push is
	call putstr
	push tmpb
	fetch half call
	putx
	call putnl
	return

halfof	string Half of 
is	string is 
