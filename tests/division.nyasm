
# Fibonacci numbers

fn1	data	1
fn	data	1

fib	push	fn1
	fetch
	push fn
	fetch
	push fn1
	store add
	push fn
	store return	

absfib	call fib
	call abs1
	return


$start	push 12	# outer loop
outer	snz
	jump @outdone
			# inner loop
	push 0		# will loop 4096 times before it hits 0 and stops

loop	call absfib	# dividend
	call duplicate
	call putdecsp
	call absfib	# divisor
	call absfib	# and kills some bits, making it smaller
	and snz
	drop push 1		# don't divide by zero
	call duplicate
	call putdecsp
	call pdiv
	swap		# print quotient first
	call putdecsp	# quotient
	call putdec		# remainder
	call putnl
	neg not snz
	jump @indone	# exit inner loop
	jump @loop
indone	drop neg not	# drop inner count, dec outer count
	call duplicate	# reseed fib gen from loop count
	push fn
	store drop
	jump @outer
	
outdone	drop push 0	# drop loop count for tidiness
	call exit
	
	
