# Count down seconds
# Needs basics in low memory

main	push cdown
	call putstr
	call putnl
	
	push 11
	times
		call duplicate
		call putdec
		call putnl
		push
		1000
		times
			push	# times loop overhead is 17 40 ns cycles
			1470 	# or 680 ns. 1470 iterations is almost
			times	# exactly 1 ms.
			repeat
		repeat
	repeat
	
	push blast
	call putstr
	call putnl
	
	return
	
cdown	string Countdown:
blast	string Blastoff!
